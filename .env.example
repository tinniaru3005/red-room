# Live Switch mode (not needed for `redroom demo --offline`).
# Get these from Switch Console / your Switch server.
SWITCH_BASE_URL=http://localhost:8000
SWITCH_REGISTRATION_TOKEN=            # one-time token to register the agent
SWITCH_API_KEY=                        # set after registration (or let `redroom register` write it)
SWITCH_AGENT_ID=
SWITCH_ROOM_ID=                        # the room the red-team agent works in
SWITCH_FIX_ROOM_ID=                    # optional linked room for the coding agent

# The agent under test (defaults target the bundled reference agent).
REDROOM_TARGET_URL=http://127.0.0.1:8900/agent
